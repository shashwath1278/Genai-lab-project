# --- LLM (pick one; the app uses whichever key is set) ---------------------
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini            # gemini | groq (forces one when both keys are set)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b    # reads photos and scanned documents
# GEMINI_VISION_MODEL=gemini-3.5-flash

# --- Web search (optional) ---------------------------------------------------
# Lets the assistant check official sites (gov.in, nic.in, NTA, KEA, COMEDK...)
# for things outside the handbook, like entrance-exam dates. Free plan:
# https://app.tavily.com (1,000 credits a month, no card). Leave empty to turn it off.
TAVILY_API_KEY=

# --- Admin dashboard ---------------------------------------------------------
# Leave empty to keep /admin open (fine on localhost).
ADMIN_PASSCODE=
